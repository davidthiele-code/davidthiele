<style>
footer{background:#0B0B0D;border-top:1px solid rgba(245,243,238,0.08);padding:64px 28px 32px}
.footer-top{max-width:1160px;margin:0 auto;display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:48px;padding-bottom:40px;border-bottom:1px solid rgba(245,243,238,0.08);margin-bottom:32px}
.footer-logo{font-family:'Space Grotesk',sans-serif;font-size:22px;font-weight:600;color:#F5F3EE;margin-bottom:14px}
.footer-logo em{font-style:normal;color:#D4A64A;font-weight:700}
.footer-desc{font-family:'Inter',sans-serif;font-size:14px;color:rgba(245,243,238,0.4);line-height:1.75;margin-bottom:20px;max-width:340px}
.footer-contact{display:flex;flex-direction:column;gap:8px}
.footer-contact a{font-family:'Inter',sans-serif;font-size:14px;color:rgba(245,243,238,0.55);transition:color 0.2s}
.footer-contact a:hover{color:#D4A64A}
.footer-col h4{font-family:'Inter',sans-serif;font-size:10.5px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:rgba(245,243,238,0.3);margin-bottom:18px}
.footer-col ul{list-style:none;display:flex;flex-direction:column;gap:11px}
.footer-col ul li a{font-family:'Inter',sans-serif;font-size:14px;color:rgba(245,243,238,0.5);transition:color 0.2s}
.footer-col ul li a:hover{color:#F5F3EE}
.footer-bottom{max-width:1160px;margin:0 auto;display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap}
.footer-bottom p{font-family:'Inter',sans-serif;font-size:12px;color:rgba(245,243,238,0.24)}
@media(max-width:960px){.footer-top{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.footer-top{grid-template-columns:1fr}}
</style>

<footer>
  <div class="footer-top">
    <div>
      <div class="footer-logo">David <em>Thiele</em></div>
      <p class="footer-desc">Producer, songwriter, and artist. Music available for licensing and sync — placements on Fox, CBS, ABC, The CW, Showtime, Telemundo, Hallmark, Netflix, and more.</p>
      <div class="footer-contact">
        <a href="/contact">Get in touch →</a>
      </div>
    </div>
    <div class="footer-col">
      <h4>Explore</h4>
      <ul>
        <li><a href="/recordings">Recordings</a></li>
        <li><a href="/hire-production-mixing-mastering">Production / Mixing / Mastering</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Publisher Info</h4>
      <ul>
        <li>THEEL GOOD MUSIC (BMI)</li>
        <li>Writer: David John Thiele</li>
        <li>Sync licensing inquiries welcome</li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} David Thiele. All rights reserved.</p>
    <p>Produced, mixed &amp; mastered in Portland, OR.</p>
  </div>
</footer>
