---
const navLinks = [
  { href: '/recordings', label: 'Recordings' },
  { href: '/hire-production-mixing-mastering', label: 'Hire Me' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<style>
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:0 28px;transition:background 0.3s,box-shadow 0.3s}
nav.stuck{background:rgba(11,11,13,0.92);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:0 1px 0 rgba(245,243,238,0.08)}
.nav-in{max-width:1160px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:78px}
.nav-logo{font-family:'Fraunces',serif;font-size:22px;font-weight:600;letter-spacing:0.01em;color:#F5F3EE}
.nav-logo em{font-style:italic;color:#D4A64A;font-weight:500}
.nav-links{display:flex;align-items:center;gap:34px}
.nav-links a{font-family:'Inter',sans-serif;font-size:13px;font-weight:500;letter-spacing:0.04em;text-transform:uppercase;color:rgba(245,243,238,0.62);transition:color 0.2s}
.nav-links a:hover,.nav-links a.active{color:#D4A64A!important}
.nav-cta{padding:11px 22px;background:#D4A64A;color:#141208!important;border-radius:2px;font-weight:600;font-size:12.5px;letter-spacing:0.04em;text-transform:uppercase;transition:background 0.2s,transform 0.15s}
.nav-cta:hover{background:#EAC773!important;transform:translateY(-1px)}
.hamburger{display:none;background:none;border:none;padding:4px;color:#F5F3EE;font-size:22px;cursor:pointer}
.mobile-menu{display:none;position:fixed;inset:0;z-index:99;background:#0B0B0D;padding:100px 28px 40px;flex-direction:column;gap:4px}
.mobile-menu.open{display:flex}
.mobile-menu a{font-family:'Fraunces',serif;font-size:28px;font-weight:500;letter-spacing:-0.01em;color:rgba(245,243,238,0.85);padding:14px 0;border-bottom:1px solid rgba(245,243,238,0.08);transition:color 0.2s}
.mobile-menu a:hover{color:#D4A64A}
.mobile-menu .m-cta{margin-top:24px;padding:16px;background:#D4A64A;color:#141208;border-radius:2px;text-align:center;font-family:'Inter',sans-serif;font-size:15px;font-weight:600;border-bottom:none}
@media(max-width:900px){.nav-links{display:none}.hamburger{display:block}}
</style>

<div class="mobile-menu" id="mobileMenu">
  {navLinks.map(link => (
    <a href={link.href} onclick="document.getElementById('mobileMenu').classList.remove('open');document.getElementById('hamburger').textContent='☰'">{link.label}</a>
  ))}
  <a href="/contact" class="m-cta">Get In Touch</a>
</div>

<nav id="nav">
  <div class="nav-in">
    <a href="/" class="nav-logo">David <em>Thiele</em></a>
    <div class="nav-links">
      {navLinks.map(link => (
        <a href={link.href} class={currentPath.startsWith(link.href) ? 'active' : ''}>{link.label}</a>
      ))}
      <a href="/contact" class="nav-cta">Get In Touch</a>
    </div>
    <button class="hamburger" id="hamburger" aria-label="Menu">☰</button>
  </div>
</nav>
