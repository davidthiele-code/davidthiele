---
import Layout from '../layouts/Layout.astro';

const placements = ['Fox Networks', 'CBS Television', 'ABC', 'Kraft Heinz', 'Aetna', 'The WB', 'The CW', 'Showtime', 'Telemundo'];

const reviews = [
  { quote: "David's work exudes such a lively, chunky human quality while sounding modern and impactful. Hire this man! He will knock it out of the park.", name: 'Joe Uzzo', role: 'Artist / Songwriter / Producer — FAVORITES, New Sheriffs' },
  { quote: "David is among the top producers I have worked with, and I've worked with many of the greats. Highly creative, adventurous, and precise.", name: 'Justina Shandler', role: 'Artist / Songwriter — JELAINA' },
  { quote: "I run a sync licensing agency and David is one of our top go-to producers when we need high quality work done quickly. He always delivers.", name: 'Celia Rose', role: 'Founder, What Up Pitches' },
];
---

<Layout title="David Thiele | Producer, Songwriter, Artist — Music for Sync & Licensing">

<style>
.hero{position:relative;padding:190px 28px 120px;background:radial-gradient(ellipse 900px 500px at 50% -10%,rgba(212,166,74,0.14),transparent),var(--bg);text-align:center;overflow:hidden}
.hero-in{max-width:820px;margin:0 auto;position:relative;z-index:2}
.hero h1{font-family:var(--serif);font-size:clamp(40px,6.4vw,80px);font-weight:600;line-height:1.02;letter-spacing:-0.02em;color:var(--text);margin-bottom:26px}
.hero h1 em{font-style:italic;color:var(--accent-bright);font-weight:500}
.hero p{font-size:18px;color:var(--text-body);line-height:1.75;max-width:600px;margin:0 auto 44px}
.hero-btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:64px}
.hero-wave{display:flex;align-items:center;justify-content:center;gap:4px;height:44px;opacity:0.7}
.hero-wave span{display:block;width:3px;background:var(--accent);border-radius:2px;animation:wv 1.8s ease-in-out infinite}
@keyframes wv{0%,100%{transform:scaleY(0.3)}50%{transform:scaleY(1)}}

.about-sec{display:grid;grid-template-columns:0.9fr 1.1fr;gap:64px;align-items:start}
.about-sec .s-header{margin-bottom:0}
.about-list{display:flex;flex-direction:column;gap:0;border-top:1px solid var(--border)}
.about-row{display:flex;justify-content:space-between;padding:18px 0;border-bottom:1px solid var(--border);font-family:var(--sans);font-size:14px}
.about-row span:first-child{color:var(--text-muted);letter-spacing:0.04em;text-transform:uppercase;font-size:11px}
.about-row span:last-child{color:var(--text);text-align:right}

.rec-teaser{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.rec-teaser-art{aspect-ratio:1;background:linear-gradient(135deg,var(--bg3),var(--bg2));border:1px solid var(--border);border-radius:var(--radius-lg);display:flex;align-items:center;justify-content:center}
@media(max-width:860px){.about-sec,.rec-teaser{grid-template-columns:1fr;gap:32px}}
</style>

<section class="hero">
  <div class="hero-in reveal on">
    <span class="tag-line" style="justify-content:center">Producer · Songwriter · Artist</span>
    <h1>Music that earns its place <em>in the scene.</em></h1>
    <p>David Thiele is an award-winning artist, songwriter, and producer. His catalog offers easy, one-stop options for music supervisors and editors — plus custom composition for film, TV, and advertising, backed by a team of trusted songwriters and producers.</p>
    <div class="hero-btns">
      <a href="/recordings" class="btn-gold">Browse the Catalog</a>
      <a href="/hire-production-mixing-mastering" class="btn-ghost">Hire Me to Produce</a>
    </div>
    <div class="hero-wave" aria-hidden="true">
      {Array.from({length: 28}).map((_, i) => <span style={`height:${14 + Math.abs(14-i)*2.2}%;animation-delay:${i*0.06}s`}></span>)}
    </div>
  </div>
</section>

<div class="credits-strip">
  <div class="credits-in">
    <p class="credits-label">Some of the places David's music has been placed</p>
    <div class="credits-row">
      {placements.map(p => <span class="credit-pill reveal on">{p}</span>)}
    </div>
  </div>
</div>

<section class="sec sec-1">
  <div class="container about-sec">
    <div class="s-header reveal">
      <span class="tag-line">About</span>
      <h2 class="s-title">30 years behind the board, still chasing <em>the take.</em></h2>
      <p class="s-sub">I love producing music and bringing songs to life. Pop, rock, Americana, soul, country, hip hop — I play guitar, piano, and bass, and program everything else, with live drums, strings, and horns available through a network of great musicians.</p>
    </div>
    <div class="about-list reveal">
      <div class="about-row"><span>Publisher</span><span>THEEL GOOD MUSIC (BMI)</span></div>
      <div class="about-row"><span>Writer</span><span>David John Thiele</span></div>
      <div class="about-row"><span>Instruments</span><span>Guitar · Piano · Bass · Programming</span></div>
      <div class="about-row"><span>Genres</span><span>Pop · Rock · Americana · Soul · Country · Hip Hop</span></div>
      <div class="about-row"><span>Services</span><span>Production · Mixing · Mastering</span></div>
      <div class="about-row"><span>Delivery</span><span>Streaming-ready &amp; sync-pitch-friendly</span></div>
    </div>
  </div>
</section>

<section class="sec sec-2">
  <div class="container rec-teaser">
    <div class="reveal">
      <span class="tag-line">Music Library</span>
      <h2 class="s-title">Available for <em>sync</em> right now.</h2>
      <p class="s-sub">A growing catalog of one-stop, pitch-ready tracks — cleared and easy to license for supervisors and editors working against a deadline.</p>
      <a href="/recordings" class="btn-gold" style="margin-top:32px">Listen to the Catalog</a>
    </div>
    <div class="rec-teaser-art reveal">
      <div class="waveform">
        {Array.from({length: 22}).map((_, i) => <span style={`height:${20 + Math.abs(11-i)*3.5}px`}></span>)}
      </div>
    </div>
  </div>
</section>

<section class="sec sec-1">
  <div class="container">
    <div class="s-header center reveal">
      <span class="tag-line">Reviews</span>
      <h2 class="s-title">What artists say</h2>
    </div>
    <div class="t-grid">
      {reviews.map(r => (
        <div class="t-card reveal">
          <p class="t-quote">{r.quote}</p>
          <div>
            <div class="t-name">{r.name}</div>
            <div class="t-role">{r.role}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="cta-sec">
  <div class="container">
    <h2>Have a project in mind?</h2>
    <p>Whether you're pitching for sync or need a full production, let's talk about what you're making.</p>
    <a href="/contact" class="btn-dark">Get In Touch</a>
  </div>
</section>

</Layout>
