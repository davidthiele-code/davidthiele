---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found | David Thiele">
<style>
.nf{min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:160px 28px 80px}
.nf h1{font-family:var(--serif);font-size:clamp(60px,10vw,140px);color:var(--accent);font-weight:600;line-height:1;margin-bottom:20px}
.nf p{font-size:17px;color:var(--text-body);margin-bottom:32px}
</style>
<div class="nf">
  <h1>404</h1>
  <p>This track doesn't exist. Let's get you back on the right cue.</p>
  <a href="/" class="btn-gold">Back Home</a>
</div>
</Layout>
